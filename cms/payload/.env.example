# Local prototype only. Copy to .env and replace every CHANGE_ME value.
DATABASE_URL=postgresql://ava:CHANGE_ME@127.0.0.1:5432/ava_cms
PAYLOAD_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES

# Optional S3-compatible private object storage. When S3_BUCKET is empty,
# Payload keeps prototype uploads in local storage.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
