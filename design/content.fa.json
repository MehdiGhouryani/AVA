  "stories": [
    {
      "id": "little_seed",
      "unitId": "unit_words",
      "title": "دانهٔ کوچک",
      "subtitle": "یک قصه دربارهٔ صبر و مراقبت",
      "order": 1,
      "artRef": "decor.tree",
      "pages": [
        {
          "id": "little_seed_page_01",
          "text": "آوا گفت: «بیا برای دانه یک خانه بسازیم!» او دانه را آرام در خاک گذاشت.",
          "audioRef": "story.little_seed.page_01"
        },
        {
          "id": "little_seed_page_02",
          "text": "دانه زیر خاک خوابید. آوا برایش کمی آب آورد.",
          "audioRef": "story.little_seed.page_02"
        },
        {
          "id": "little_seed_page_03",
          "text": "هر روز آوا به باغ سر زد. خورشید گرم می‌تابید و دانه آرام رشد می‌کرد.",
          "audioRef": "story.little_seed.page_03"
        },
        {
          "id": "little_seed_page_04",
          "text": "یک صبح، جوانه‌ای کوچک از خاک بیرون آمد. آوا لبخند زد.",
          "audioRef": "story.little_seed.page_04"
        },
        {
          "id": "little_seed_page_05",
          "text": "آوا گفت: «با کمی صبر و مراقبت، چیزهای کوچک هم بزرگ می‌شوند.»",
          "audioRef": "story.little_seed.page_05"
        }
      ],
      "question": "آوا برای دانه چه آورد؟",
      "choices": [
        "آب",
        "توپ",
        "کفش"
      ],
      "answer": "آب"
    },
    {
      "id": "friends_book",
      "unitId": "unit_words",
      "title": "کتابِ دوستان",
      "subtitle": "یک کتاب و چند دوست مهربان",
      "order": 2,
      "artRef": "decor.magic_book",
      "pages": [
        {
          "id": "friends_book_page_01",
          "text": "آوا یک کتاب تازه پیدا کرد. روی جلدش یک ستاره بود.",
          "audioRef": "story.friends_book.page_01"
        },
        {
          "id": "friends_book_page_02",
          "text": "خرگوش و روباه آمدند. سنجاب هم کنارشان نشست.",
          "audioRef": "story.friends_book.page_02"
        },
        {
          "id": "friends_book_page_03",
          "text": "آوا کتاب را باز کرد. هر دوست یک تصویر تازه در آن پیدا کرد.",
          "audioRef": "story.friends_book.page_03"
        },
        {
          "id": "friends_book_page_04",
          "text": "دوستان گفتند: «خواندن کنار هم چه لذتی دارد!» کتاب دوباره در باغ باز شد.",
          "audioRef": "story.friends_book.page_04"
        }
      ],
      "question": "دوستان با هم چه خواندند؟",
      "choices": [
        "کفش",
        "کتاب",
        "توپ"
      ],
      "answer": "کتاب"
    }
  ]
