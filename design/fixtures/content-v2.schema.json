{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava.local/schemas/content-v2.json",
  "title": "AVA development content v2",
  "type": "object",
  "required": ["version", "approvedForRelease", "scope", "lessons", "stories"],
  "properties": {
    "version": {"const": 2},
    "approvedForRelease": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "lessons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lesson"}},
    "stories": {"type": "array", "items": {"$ref": "#/$defs/story"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "lesson": {
      "type": "object",
      "required": ["id", "title", "goal", "tasks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/choiceTask"}, {"$ref": "#/$defs/buildTask"}]}}
      },
      "additionalProperties": false
    },
    "choiceTask": {
      "type": "object",
      "required": ["id", "kind", "target", "choices"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["recognize", "listen"]},
        "target": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "buildTask": {
      "type": "object",
      "required": ["id", "kind", "target", "tokens"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "build_word"},
        "target": {"type": "string", "minLength": 2},
        "tokens": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": ["id", "title", "subtitle", "art", "pages", "question", "choices", "answer"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "art": {"type": "string", "minLength": 1},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "question": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "answer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
