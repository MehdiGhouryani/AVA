{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava.local/schemas/content-v3.json",
  "title": "AVA development content v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "locale",
    "approvedForRelease",
    "scope",
    "skills",
    "levels",
    "stories"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$"
    },
    "locale": {
      "const": "fa-IR"
    },
    "approvedForRelease": {
      "const": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "units"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "order",
        "tasks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/choiceTask"
              },
              {
                "$ref": "#/$defs/buildTask"
              }
            ]
          }
        }
      }
    },
    "choiceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "skillIds",
        "assetRefs",
        "audioRequiredForPublication",
        "kind",
        "audioRef",
        "writtenFallback",
        "choices"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "skillIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assetRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "audioRequiredForPublication": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "recognize",
            "listen",
            "dot_family",
            "positional_form",
            "initial_sound",
            "final_sound"
          ]
        },
        "audioRef": {
          "$ref": "#/$defs/ref"
        },
        "writtenFallback": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "buildTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "skillIds",
        "assetRefs",
        "audioRequiredForPublication",
        "kind",
        "audioRef",
        "writtenFallback",
        "tokens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "string",
          "minLength": 2
        },
        "skillIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assetRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "audioRequiredForPublication": {
          "const": false
        },
        "kind": {
          "enum": ["build_word", "segment", "blend"]
        },
        "audioRef": {
          "type": "null"
        },
        "writtenFallback": {
          "type": "null"
        },
        "tokens": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "storyPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "audioRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audioRef": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unitId",
        "title",
        "subtitle",
        "order",
        "artRef",
        "pages",
        "question",
        "choices",
        "answer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unitId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "artRef": {
          "$ref": "#/$defs/ref"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storyPage"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
