{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava.local/schemas/cms-export-v1.json",
  "title": "AVA private CMS export candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["exportVersion", "provider", "candidateId", "status", "contentVersion", "scope", "audioAssets", "requestedBy"],
  "properties": {
    "exportVersion": {"const": 1},
    "provider": {"enum": ["payload", "strapi"]},
    "candidateId": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "status": {"enum": ["draft", "educational_review", "technical_review", "ready_for_compiler", "rejected"]},
    "contentVersion": {"type": "string"},
    "scope": {"enum": ["partial_spike", "complete_release"]},
    "requestedBy": {"type": "string", "minLength": 1},
    "audioAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recordingText", "status", "uploadedBy", "educationalReviewer", "technicalReviewer", "masterAssetKey", "deliveryAssetKey", "sha256", "licenseConsentRef"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "recordingText": {"type": "string", "minLength": 1},
          "status": {"enum": ["needs_script", "needs_recording", "quarantined", "educational_review", "technical_review", "approved", "rejected"]},
          "uploadedBy": {"type": ["string", "null"]},
          "educationalReviewer": {"type": ["string", "null"]},
          "technicalReviewer": {"type": ["string", "null"]},
          "masterAssetKey": {"type": ["string", "null"]},
          "deliveryAssetKey": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "licenseConsentRef": {"type": ["string", "null"]}
        }
      }
    }
  }
}
