  {
   "poem_id": "poem.p04",
   "title_key": "copy.poem.p04.title",
   "lines": [
    "اردک تو آب، شَلپ شُلوپ",
    "شنا می‌کنه با یه توپ",
    "پاهاش نارنجی، پَرهاش نرم",
    "آبِ برکه شده گرم"
   ],
   "rhyme_targets": [
    "شُلوپ",
    "توپ",
    "نرم",
    "گرم"
   ],
   "line_audio": [
