  {
   "poem_id": "poem.p05",
   "title_key": "copy.poem.p05.title",
   "lines": [
    "یه کتاب دارم رنگارنگ",
    "پر از قصه‌های قشنگ",
    "ورق می‌زنم آهسته",
    "تا قصه نشه خسته"
   ],
   "rhyme_targets": [
    "رنگارنگ",
