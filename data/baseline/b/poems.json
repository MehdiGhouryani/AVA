  {
   "poem_id": "poem.p03",
   "title_key": "copy.poem.p03.title",
   "lines": [
    "خرگوشِ ناز، گوش‌دراز",
    "می‌پره بالا، باز و باز",
    "تو باغ داره یه خونه",
    "هویج می‌خوره دونه‌دونه"
   ],
   "rhyme_targets": [
    "دراز",
    "باز",
    "خونه",
    "دونه‌دونه"
   ],
