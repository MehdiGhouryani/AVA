  {
   "poem_id": "poem.p01",
   "title_key": "copy.poem.p01.title",
   "lines": [
    "باران میاد شُر شُر شُر",
    "باغچه می‌شه از گل پُر",
    "ابرِ سفید، ابرِ سیاه",
    "رنگین‌کمون اومد تو راه"
   ],
   "rhyme_targets": [
