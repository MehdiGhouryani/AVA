  {
   "poem_id": "poem.p06",
   "title_key": "copy.poem.p06.title",
   "lines": [
    "سیبِ قرمز، سیبِ گرد",
    "باد اومد و اونو برد",
    "افتاد تو حوض، تاب‌تاب",
    "ماهی گفت: سلام! تو آب"
   ],
   "rhyme_targets": [
