  {
   "poem_id": "poem.p02",
   "title_key": "copy.poem.p02.title",
   "lines": [
    "ماهِ قشنگ، ماهِ بلند",
    "تو آسمون زد لبخند",
    "ستاره‌ها چشمک زدن",
    "دورِ ماه رقصیدن"
   ],
   "rhyme_targets": [
